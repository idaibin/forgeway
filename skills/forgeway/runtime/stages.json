  "goals": {
    "inspect": {
      "terminal_stage": "project-discovery",
      "description": "Fix the project basis, classify native authorities, and return the first safe next stage without target source or external mutation."
    },
    "to-spec": {
      "terminal_stage": "spec-readiness",
      "description": "Resolve only the specification lanes applicable to the requested slice and project a bounded implementation-readiness result."
    },
    "implement": {
      "terminal_stage": "implementation",
      "description": "Reach an authorized source result for one accepted Task without implying verification or delivery."
    },
    "verify": {
      "terminal_stage": "verification",
      "description": "Produce the required source, automated, artifact, and runtime evidence for the selected scope."
    },
    "review": {
      "terminal_stage": "review",
      "description": "Complete an independent fixed-basis review after applicable verification."
    },
    "deliver": {
      "terminal_stage": "close",
      "description": "Complete separately authorized delivery actions and close as Pass, Fail, Blocked, Gap, or Change."
    }
  },
