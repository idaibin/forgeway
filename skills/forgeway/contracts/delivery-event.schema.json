{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:delivery-event:v1",
  "title": "Forgeway append-only delivery event",
  "type": "object",
  "additionalProperties": false,
  "required": ["sequence", "event_id", "event_type", "entity_type", "entity_id", "occurred_at", "payload", "payload_sha256"],
  "properties": {
    "sequence": { "type": "integer", "minimum": 1 },
    "event_id": { "type": "string", "pattern": "^event:[A-Za-z0-9._:-]+$" },
    "event_type": { "enum": ["package.created", "policy.registered", "run.created", "attempt.created", "observation.recorded", "delivery.receipt.created", "deployment.receipt.created"] },
    "entity_type": { "enum": ["package", "policy", "run", "attempt", "observation", "receipt"] },
    "entity_id": { "type": "string", "minLength": 1 },
    "occurred_at": { "type": "string", "format": "date-time" },
    "payload": { "type": "object" },
    "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
