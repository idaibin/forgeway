{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:workspace:v1",
  "title": "Workspace bootstrap (not a Project delivery manifest)",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "workspace_id", "name", "source_package_id", "applications"],
  "properties": {
    "schema_version": { "const": "forgeway-workspace/1" },
    "workspace_id": { "type": "string", "pattern": "^workspace:[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$" },
    "name": { "type": "string", "minLength": 1, "maxLength": 100, "pattern": "^[^\\u0000-\\u001f\\u007f]+$" },
    "source_package_id": { "type": "string", "pattern": "^pkg:[0-9a-f]{64}$" },
    "starter": { "const": "http-demo" },
    "project_type": { "enum": ["undecided", "frontend", "backend", "fullstack", "cli", "library"] },
    "applications": {
      "type": "array", "minItems": 1, "maxItems": 20,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
          "path": { "type": "string", "pattern": "^apps/[a-z][a-z0-9-]{0,39}$" },
          "stack": { "enum": ["undecided", "vue", "react", "java", "rust", "node", "vanilla"] }
        }
      }
    }
  }
}
