{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:task:v1",
  "title": "Task dispatch record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "requirement_ids", "owner", "basis", "scope", "dependencies", "outputs", "commands", "stop_conditions"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
    "id": { "$ref": "urn:forgeway:common:v1#/$defs/taskId" },
    "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:forgeway:common:v1#/$defs/requirementId" } },
    "owner": { "$ref": "urn:forgeway:common:v1#/$defs/owner" },
    "basis": {},
    "scope": { "type": "object", "additionalProperties": false, "required": ["include", "exclude"], "properties": { "include": { "type": "array", "minItems": 1 }, "exclude": { "type": "array" } } },
    "dependencies": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 3 } },
    "outputs": { "type": "array", "minItems": 1 },
    "commands": { "type": "array", "minItems": 1 },
    "stop_conditions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 5 } }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "basis": { "type": "object", "additionalProperties": false, "required": ["repository", "commit_sha"], "properties": { "repository": { "type": "string", "minLength": 2 }, "commit_sha": { "$ref": "urn:forgeway:common:v1#/$defs/commitSha" } } },
          "scope": { "type": "object", "properties": { "include": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/relativePath" } }, "exclude": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/relativePath" } } } },
          "outputs": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/artifactRef" } },
          "commands": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/command" } }
        }
      }
    },
    {
      "if": { "properties": { "schema_version": { "enum": ["1.1", "1.2"] } }, "required": ["schema_version"] },
      "then": {
        "properties": {
          "basis": { "type": "array", "minItems": 1, "items": { "$ref": "urn:forgeway:common:v1#/$defs/basisRef" } },
          "scope": { "type": "object", "properties": { "include": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/scopeRef" } }, "exclude": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/scopeRef" } } } },
          "outputs": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/scopedArtifactRef" } },
          "commands": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/scopedCommand" } }
        }
      }
    }
  ]
}
