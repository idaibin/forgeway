{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:portfolio:v1",
  "title": "Cross-project validation campaign",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "campaign_id", "system_commit_sha", "expected_projects", "required_profiles", "required_gates", "projects"],
  "properties": {
    "schema_version": { "$ref": "urn:forgeway:common:v1#/$defs/schemaVersion" },
    "campaign_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "system_commit_sha": { "$ref": "urn:forgeway:common:v1#/$defs/commitSha" },
    "expected_projects": { "type": "integer", "minimum": 1, "maximum": 100 },
    "required_profiles": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["java-fullstack", "rust-fullstack", "custom"] } },
    "required_gates": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:forgeway:common:v1#/$defs/gate" } },
    "evidence_root": { "$ref": "urn:forgeway:common:v1#/$defs/relativePath" },
    "projects": { "type": "array", "minItems": 1 }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
      "then": { "properties": { "projects": { "type": "array", "items": { "$ref": "#/$defs/projectV1" } } } }
    },
    {
      "if": { "properties": { "schema_version": { "const": "1.1" } }, "required": ["schema_version"] },
      "then": { "properties": { "projects": { "type": "array", "items": { "$ref": "#/$defs/projectV1_1" } } } }
    }
  ],
  "$defs": {
    "projectV1": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "repository", "ref", "commit_sha", "mode", "profile", "project_manifest", "requirement_ids"],
      "properties": {
        "project_id": { "$ref": "urn:forgeway:common:v1#/$defs/repositoryId" },
        "repository": { "type": "string", "minLength": 2 },
        "ref": { "type": "string", "minLength": 1 },
        "commit_sha": { "$ref": "urn:forgeway:common:v1#/$defs/commitSha" },
        "mode": { "enum": ["adoption", "delivery"] },
        "profile": { "enum": ["java-fullstack", "rust-fullstack", "custom"] },
        "project_manifest": { "$ref": "urn:forgeway:common:v1#/$defs/relativePath" },
        "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:forgeway:common:v1#/$defs/requirementId" } }
      }
    },
    "projectV1_1": {
      "type": "object", "additionalProperties": false,
      "required": ["project_id", "topology", "repositories", "components", "mode", "profile", "manifest_source", "project_manifest", "requirement_ids"],
      "properties": {
        "project_id": { "$ref": "urn:forgeway:common:v1#/$defs/repositoryId" },
        "topology": { "enum": ["monolith", "monorepo", "polyrepo"] },
        "repositories": { "type": "array", "minItems": 1, "items": { "$ref": "urn:forgeway:common:v1#/$defs/repositoryRecord" } },
        "components": { "type": "array", "minItems": 1, "items": { "$ref": "urn:forgeway:common:v1#/$defs/componentRecord" } },
        "mode": { "enum": ["adoption", "delivery"] },
        "profile": { "enum": ["java-fullstack", "rust-fullstack", "custom"] },
        "manifest_source": { "enum": ["campaign", "project"] },
        "manifest_repository_id": { "$ref": "urn:forgeway:common:v1#/$defs/repositoryId" },
        "project_manifest": { "$ref": "urn:forgeway:common:v1#/$defs/relativePath" },
        "requirement_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "urn:forgeway:common:v1#/$defs/requirementId" } }
      },
      "allOf": [
        {
          "if": { "properties": { "manifest_source": { "const": "campaign" } }, "required": ["manifest_source"] },
          "then": { "properties": { "project_manifest": { "type": "string", "pattern": "^evaluation/campaigns/.+" } }, "not": { "properties": { "manifest_repository_id": {} }, "required": ["manifest_repository_id"] } }
        },
        {
          "if": { "properties": { "manifest_source": { "const": "project" } }, "required": ["manifest_source"] },
          "then": { "properties": { "manifest_repository_id": {} }, "required": ["manifest_repository_id"] }
        }
      ]
    }
  }
}
