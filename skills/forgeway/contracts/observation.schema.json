{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:observation:v1",
  "title": "Forgeway result-bound observation",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "run_id",
    "attempt_id",
    "result_package_id",
    "kind",
    "environment",
    "outcome",
    "observed_at",
    "producer",
    "collector",
    "permission",
    "validation",
    "payload"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "observation_id": { "type": "string", "minLength": 1, "pattern": "^obs:[A-Za-z0-9._:-]+$" },
    "run_id": { "type": "string", "minLength": 1, "pattern": "^run:[A-Za-z0-9._:-]+$" },
    "attempt_id": { "type": "string", "minLength": 1, "pattern": "^attempt:[A-Za-z0-9._:-]+$" },
    "result_package_id": { "type": "string", "minLength": 8, "pattern": "^pkg:[A-Za-z0-9._:-]+$" },
    "kind": {
      "enum": [
        "source-assertion",
        "command-execution",
        "artifact-validation",
        "runtime-observation",
        "review-finding",
        "delivery-receipt",
        "deployment-receipt",
        "production-probe"
      ]
    },
    "environment": { "enum": ["local", "target-like", "deployed", "production"] },
    "outcome": {
      "enum": ["satisfied", "unsatisfied", "not-verified"]
    },
    "observed_at": { "type": "string", "format": "date-time" },
    "producer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["capability_id", "capability_version"],
      "properties": {
        "capability_id": { "type": "string", "minLength": 1 },
        "capability_version": { "type": "string", "minLength": 1 },
        "actor": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 }
      }
    },
    "collector": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "permission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "granted", "authorization_ref"],
      "properties": {
        "mode": { "type": "string", "minLength": 1 },
        "granted": { "type": "boolean" },
        "authorization_ref": { "type": "string", "minLength": 1 }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "contract_version", "validator_id", "validated_at", "payload_sha256", "result_package_aggregate_sha256", "eligible", "authorization_receipt"],
      "properties": {
        "contract_id": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string", "minLength": 1 },
        "validator_id": { "type": "string", "minLength": 1 },
        "validated_at": { "type": "string", "format": "date-time" },
        "payload_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "result_package_aggregate_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "eligible": { "type": "boolean" },
        "authorization_receipt": { "type": "string", "minLength": 1 },
        "reason": { "type": "string", "minLength": 1 }
      }
    },
    "claim_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "artifact_hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "limitations": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "payload": { "type": "object", "additionalProperties": true }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "source-assertion" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["assertion_id", "resolved"], "properties": { "assertion_id": { "type": "string", "minLength": 1 }, "resolved": { "type": "boolean" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "command-execution" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["command", "exit_code"], "properties": { "command": { "oneOf": [{ "type": "string", "minLength": 1 }, { "type": "array", "minItems": 1 }] }, "exit_code": { "type": "integer" } } } } }
    },
    {
      "if": { "properties": { "kind": { "const": "artifact-validation" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["validator_id", "valid"], "properties": { "validator_id": { "type": "string", "minLength": 1 }, "valid": { "type": "boolean" } }, "anyOf": [{ "required": ["artifact_id"] }, { "required": ["artifact_hash"] }] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "review-finding" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["finding_count", "blocking_count", "summary"] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "runtime-observation" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["check_id", "observed_state", "status"] } } }
    },
    {
      "if": { "properties": { "kind": { "const": "production-probe" } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["probe_id", "target_identity", "observed_state", "status"] } } }
    },
    {
      "if": { "properties": { "kind": { "enum": ["delivery-receipt", "deployment-receipt"] } }, "required": ["kind"] },
      "then": { "properties": { "payload": { "required": ["receipt_id", "target", "readback"] } } }
    }
  ]
}
