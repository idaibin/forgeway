{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:run:v1",
  "title": "Forgeway immutable delivery run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "input_basis_package_id",
    "capability_id",
    "input_refs",
    "scope",
    "policy_ref",
    "initiator",
    "created_at"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "minLength": 1, "pattern": "^run:[A-Za-z0-9._:-]+$" },
    "input_basis_package_id": { "type": "string", "minLength": 8, "pattern": "^pkg:[A-Za-z0-9._:-]+$" },
    "capability_id": { "type": "string", "minLength": 1 },
    "input_refs": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "id"],
            "properties": {
              "kind": { "type": "string", "minLength": 1 },
              "id": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "scope": {
      "type": "array",
      "items": {
        "oneOf": [
          { "type": "string", "minLength": 1 },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["path"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "asset_id": { "type": "string", "minLength": 1 }
            }
          }
        ]
      }
    },
    "policy_ref": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["policy_id", "version"],
          "properties": {
            "policy_id": { "type": "string", "minLength": 1 },
            "version": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "initiator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 }
      }
    },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
