{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:project:v1",
  "title": "Adopted project manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_id", "name", "owners", "profile", "artifacts", "commands"],
  "properties": {
    "schema_version": { "enum": ["1.0", "1.1", "1.2"] },
    "project_id": { "$ref": "urn:forgeway:common:v1#/$defs/repositoryId" },
    "name": { "type": "string", "minLength": 2 },
    "repository": { "type": "string", "minLength": 2 },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ref", "commit_sha"],
      "properties": {
        "ref": { "type": "string", "minLength": 1 },
        "commit_sha": { "$ref": "urn:forgeway:common:v1#/$defs/commitSha" }
      }
    },
    "topology": { "enum": ["monolith", "monorepo", "polyrepo"] },
    "repositories": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:forgeway:common:v1#/$defs/repositoryRecord" }
    },
    "components": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "urn:forgeway:common:v1#/$defs/componentRecord" }
    },
    "owners": { "type": "array", "minItems": 1, "items": { "$ref": "urn:forgeway:common:v1#/$defs/owner" } },
    "profile": { "enum": ["java-fullstack", "rust-fullstack", "custom"] },
    "artifacts": { "type": "array", "minItems": 1 },
    "commands": { "type": "array", "minItems": 1 },
    "runtime_requirements": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": { "properties": { "schema_version": { "const": "1.0" } }, "required": ["schema_version"] },
      "then": {
        "required": ["repository", "basis"],
        "properties": {
          "repository": {},
          "basis": {},
          "artifacts": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/artifactRef" } },
          "commands": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/command" } }
        },
        "not": { "anyOf": [
          { "properties": { "topology": {} }, "required": ["topology"] },
          { "properties": { "repositories": {} }, "required": ["repositories"] },
          { "properties": { "components": {} }, "required": ["components"] }
        ] }
      }
    },
    {
      "if": { "properties": { "schema_version": { "enum": ["1.1", "1.2"] } }, "required": ["schema_version"] },
      "then": {
        "required": ["topology", "repositories", "components"],
        "properties": {
          "topology": {},
          "repositories": {},
          "components": {},
          "artifacts": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/scopedArtifactRef" } },
          "commands": { "type": "array", "items": { "$ref": "urn:forgeway:common:v1#/$defs/scopedCommand" } }
        },
        "not": { "anyOf": [
          { "properties": { "repository": {} }, "required": ["repository"] },
          { "properties": { "basis": {} }, "required": ["basis"] }
        ] }
      }
    }
  ]
}
