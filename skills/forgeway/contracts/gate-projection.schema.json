{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:forgeway:gate-projection:v1",
  "title": "Forgeway computed gate projection",
  "type": "object",
  "required": ["schema_version", "run_id", "policy_ref", "input_basis_package_id", "result_package_id", "predicates"],
  "properties": {
    "schema_version": { "const": "1.0" },
    "run_id": { "type": "string", "pattern": "^run:[A-Za-z0-9._:-]+$" },
    "policy_ref": {
      "type": "object",
      "required": ["policy_id", "version"],
      "properties": {
        "policy_id": { "type": "string", "minLength": 1 },
        "version": { "type": "integer", "minimum": 1 }
      }
    },
    "input_basis_package_id": { "type": "string", "pattern": "^pkg:" },
    "result_package_id": { "type": ["string", "null"], "pattern": "^pkg:" },
    "predicates": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["state"],
        "properties": { "state": { "enum": ["satisfied", "unsatisfied", "not-verified", "not-applicable", "stale"] } }
      }
    }
  }
}
